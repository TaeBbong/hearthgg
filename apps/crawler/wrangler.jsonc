{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hearthgg-crawler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Cron + Workflow only; no public HTTP endpoint.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": {
    // Probe every board every 5 minutes; ticks between 23:50 and 24:00 KST also record daily history.
    "crons": ["*/5 * * * *"]
  },
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "hearthgg-snapshots" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hearthgg",
      "database_id": "ed7d3399-a694-4193-ab1a-096e9afabd02",
      "migrations_dir": "../../migrations"
    }
  ],
  "workflows": [{ "name": "hearthgg-crawl-board", "binding": "CRAWL_BOARD", "class_name": "CrawlBoardWorkflow" }]
  // Secrets: ALERT_WEBHOOK_URL (optional, Discord-compatible) — `wrangler secret put ALERT_WEBHOOK_URL`
}
