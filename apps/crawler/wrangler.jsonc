{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearthgg-crawler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "triggers": {
    // Probe every board every 5 minutes; snapshot daily history at 23:55 KST.
    "crons": ["*/5 * * * *", "55 14 * * *"]
  },
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "hearthgg-snapshots" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hearthgg",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "workflows": [{ "name": "hearthgg-crawl-board", "binding": "CRAWL_BOARD", "class_name": "CrawlBoardWorkflow" }]
  // Secrets: ALERT_WEBHOOK_URL (optional, Discord-compatible) — `wrangler secret put ALERT_WEBHOOK_URL`
}
